{
  "manifest_version": 3,
  "name": "GitHub Enhancer",
  "version": "0.1.0",
  "description": "Enhanced GitHub Experience for developers.",
  "icons": {
    "16": "dist/icons/icon-16.png",
    "32": "dist/icons/icon-32.png",
    "48": "dist/icons/icon-48.png",
    "128": "dist/icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@github-enhancer",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/icons/*.svg",
        "dist/themes/*.json"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "dist/collector-suppress.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "dist/settings.js",
        "dist/navigation-guard.js",
        "dist/themes.js"
      ],
      "css": [
        "dist/css/themes.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "dist/go-to-top.js",
        "dist/enterprise-header.js"
      ],
      "css": [
        "dist/css/go-to-top.css",
        "dist/css/enterprise-header.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*/*/actions*"
      ],
      "js": [
        "dist/workflow-filter.js",
        "dist/run-list.js",
        "dist/sidebar-resize.js",
        "dist/refresh-now.js"
      ],
      "css": [
        "dist/css/content.css",
        "dist/css/run-list.css",
        "dist/css/sidebar-resize.css",
        "dist/css/refresh-now.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*/*/actions*"
      ],
      "js": [
        "dist/run-view.js"
      ],
      "css": [
        "dist/css/run-view/sections.css",
        "dist/css/run-view/graph.css",
        "dist/css/run-view/toolbar.css"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*/*/pull/*"
      ],
      "js": [
        "dist/pr-conversation.js",
        "dist/sidebar-resize.js"
      ],
      "css": [
        "dist/css/pr-conversation.css",
        "dist/css/sidebar-resize.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
