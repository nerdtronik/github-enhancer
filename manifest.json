{
  "manifest_version": 3,
  "name": "GitHub Enhancer",
  "version": "0.1.0",
  "description": "Enhanced GitHub Experience for developers.",
  "permissions": ["storage"],
  "web_accessible_resources":[
    {
      "resources": ["assets/extension/*.svg"],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/collector-suppress.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/settings-storage.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": [
        "dist/run-view.js"
      ],
      "css": [
        "src/css/run-view/sections.css",
        "src/css/run-view/graph.css",
        "src/css/run-view/toolbar.css"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": [
        "dist/workflow-categories.js",
        "dist/content.js",
        "dist/sidebar-resize.js",
        "dist/pr-conversation.js",
        "dist/run-list.js",
        "dist/go-to-top.js"
      ],
      "css": [
        "src/css/content.css",
        "src/css/sidebar-resize.css",
        "src/css/pr-conversation.css",
        "src/css/run-list.css",
        "src/css/go-to-top.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
