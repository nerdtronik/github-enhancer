{
  "manifest_version": 3,
  "name": "GitHub Enhancer",
  "version": "0.9.0",
  "description": "Filter workflows and display readable, scrollable job stages on GitHub Actions.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/js/collector-suppress.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["src/js/settings-storage.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/js/run-view/shared.js",
        "src/js/run-view/relationships.js",
        "src/js/run-view/toolbar.js",
        "src/js/run-view/jobs.js",
        "src/js/run-view/sections.js",
        "src/js/run-view.js"
      ],
      "css": [
        "src/css/run-view/sections.css",
        "src/css/run-view/graph.css",
        "src/css/run-view/toolbar.css"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/js/workflow-categories.js",
        "src/js/content.js",
        "src/js/sidebar-resize.js",
        "src/js/pr-conversation.js",
        "src/js/run-list.js",
        "src/js/go-to-top.js"
      ],
      "css": [
        "src/css/content.css",
        "src/css/sidebar-resize.css",
        "src/css/pr-conversation.css",
        "src/css/run-list.css",
        "src/css/go-to-top.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
