{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "src/ts",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["src/ts/**/*.ts"]
}
