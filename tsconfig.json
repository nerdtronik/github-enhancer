{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "rootDir": "src/ts",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/ts/**/*.ts"]
}
