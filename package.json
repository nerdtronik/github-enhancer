{
  "name": "@nerdtronik/github-enhancer",
  "version": "0.2.0",
  "description": "Enhanced GitHub experience for developers (browser extension).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdtronik/github-enhancer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE.md",
    "PRIVACY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "lint": "rslint --fix .",
    "test": "rstest",
    "bundle": "node scripts/build.js && node scripts/bundle.js",
    "check": "tsc --noEmit && rslint . && rstest"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@rslint/core": "^0.9.5",
    "@rstest/core": "^0.12.4",
    "@types/chrome": "^0.3.6",
    "@types/firefox-webext-browser": "^143.0.1",
    "esbuild": "^0.24.2",
    "happy-dom": "^20.14.6",
    "typescript": "^6.0.3"
  }
}
